{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": false,
    "types": ["node", "jest"],
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2024"],
    "target": "es2024",
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "paths": {
      "@app/battle-net": ["./libs/battle-net/src"],
      "@app/battle-net/*": ["./libs/battle-net/src/*"],
      "@app/configuration": ["./libs/configuration/src"],
      "@app/configuration/*": ["./libs/configuration/src/*"],
      "@app/logger": ["./libs/logger/src"],
      "@app/logger/*": ["./libs/logger/src/*"],
      "@app/pg": ["./libs/pg/src"],
      "@app/pg/*": ["./libs/pg/src/*"],
      "@app/resources": ["./libs/resources/src"],
      "@app/resources/*": ["./libs/resources/src/*"],
      "@app/s3": ["./libs/s3/src"],
      "@app/s3/*": ["./libs/s3/src/*"]
    }
  },
  "include": ["apps/**/*", "libs/**/*", "types/**/*", "jest.setup.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
