{
  "name": "cmnw",
  "version": "6.13.17",
  "homepage": "https://cmnw.me",
  "description": "Intelligence always wins",
  "private": true,
  "license": "MPL 2.0",
  "bugs": {
    "url": "https://github.com/alexzedim/cmnw/issues"
  },
  "author": {
    "name": "alexzedim",
    "url": "https://cmnw.me"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexzedim/cmnw.git"
  },
  "languageName": "node",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "prebuild": "swc apps libs -d dist --delete-dir-on-start --config-file .swcrc",
    "build": "swc apps libs -d dist --config-file .swcrc",
    "build:all": "swc apps libs -d dist --config-file .swcrc",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "start": "node dist/apps/api/src/main.js",
    "dev": "swc apps libs -d dist --watch --config-file .swcrc",
    "debug": "swc apps libs -d dist --config-file .swcrc && node --inspect-brk dist/apps/api/src/main.js",
    "prod": "node dist/apps/api/src/main.js",
    "lint": "biome check --write . && node scripts/audit-type-imports.mjs",
    "test": "jest --forceExit",
    "test:watch": "jest --watch --forceExit",
    "test:cov": "jest --coverage --forceExit",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "docker:build": "docker build -f docker/local.Dockerfile -t cmnw:%npm_package_version% -t cmnw:latest .",
    "version": "echo %npm_package_version%"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1103.0",
    "@bull-board/api": "8.5.0",
    "@bull-board/express": "8.5.0",
    "@bull-board/nestjs": "8.5.0",
    "@nestjs-modules/ioredis": "2.2.2",
    "@nestjs/axios": "4.0.1",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-ws": "11.1.28",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/typeorm": "11.0.3",
    "@nestjs/websockets": "11.1.28",
    "async-csv": "2.1.3",
    "axios": "^1.19.0",
    "bullmq": "6.0.8",
    "chalk": "5.6.2",
    "change-case": "5.4.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "discord-strategy": "^2.5.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "farmhash": "5.0.1",
    "fs-extra": "11.4.0",
    "ioredis": "6.0.0",
    "lodash": "4.18.1",
    "luxon": "3.7.2",
    "nestjs-s3": "3.0.1",
    "node-html-parser": "9.0.1",
    "passport": "0.7.0",
    "passport-oauth2": "1.8.0",
    "pg": "8.22.0",
    "playwright": "1.62.1",
    "playwright-extra": "4.3.6",
    "puppeteer-extra-plugin-stealth": "2.11.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.0",
    "typeorm-naming-strategies": "4.1.0",
    "uuid": "14.0.1",
    "ws": "8.21.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@nestjs/testing": "11.1.28",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.47",
    "@swc/jest": "0.2.39",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.25",
    "@types/node": "26.1.2",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.1",
    "jest": "30.4.2",
    "supertest": "7.2.2",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@nestjs/core",
      "@scarf/scarf",
      "farmhash",
      "msgpackr-extract"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "@swc/jest",
        {
          "jsc": {
            "parser": {
              "syntax": "typescript",
              "decorators": true
            },
            "transform": {
              "legacyDecorator": true,
              "decoratorMetadata": true
            },
            "target": "es2020"
          },
          "module": {
            "type": "commonjs"
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((chalk|change-case|lower-case|no-case|upper-case|capital-case|constant-case|dot-case|header-case|param-case|pascal-case|path-case|sentence-case|snake-case|title-case)|.*\\.mjs$))"
    ],
    "moduleNameMapper": {
      "^@app/battle-net(|/.*)$": "<rootDir>/libs/battle-net/src/$1",
      "^@app/configuration(|/.*)$": "<rootDir>/libs/configuration/src/$1",
      "^@app/logger(|/.*)$": "<rootDir>/libs/logger/src/$1",
      "^@app/pg(|/.*)$": "<rootDir>/libs/pg/src/$1",
      "^@app/resources(|/.*)$": "<rootDir>/libs/resources/src/$1",
      "^@app/s3(|/.*)$": "<rootDir>/libs/s3/src/$1"
    }
  }
}
